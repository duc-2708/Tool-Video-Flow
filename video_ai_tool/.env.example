# file: .env.example

# Sao chép thành .env. Không commit hoặc chia sẻ API key.

GEMINI_API_KEY=

# Điền model Gemini được tài khoản hỗ trợ; không hardcode trong code.

GEMINI_MODEL=

# Để trống để dùng GEMINI_MODEL cho Director.

GEMINI_DIRECTOR_MODEL=

# Timeout riêng cho Gemini; không dùng REQUEST_TIMEOUT_SEC của HTTP thông thường.

GEMINI_TIMEOUT_SEC=120

# Tùy chọn: model thay thế mà tài khoản có quyền sử dụng.

GEMINI_FALLBACK_MODEL=

# Gateway video Veo/Seedance; không dùng key này thay GEMINI_API_KEY.

GATEWAY_API_KEY=

GATEWAY_BASE_URL=https://api.buihuuthang.com/v1

GATEWAY_VIDEO_MODEL=veo-3.1

AI_CLIP_MAX_PER_RUN=3

YOUTUBE_API_KEY=

PEXELS_API_KEY=

PIXABAY_API_KEY=

DEFAULT_VOICE=vi-VN-HoaiMyNeural

DEFAULT_VOICE_FALLBACK=vi-VN-NamMinhNeural

REQUEST_TIMEOUT_SEC=30

RETRY_ATTEMPTS=3

CACHE_TTL_SEC=86400

YOUTUBE_DAILY_QUOTA=10000

YOUTUBE_MAX_SEARCHES_PER_RUN=2

LOG_LEVEL=INFO



# Exact gateway model IDs; comma-separated or JSON array.

GATEWAY_ALLOWED_MODELS=veo-3.1,seedance-2.5-30s



# Default clip duration; must match GATEWAY_VIDEO_MODEL.

AI_CLIP_SECONDS=4



GEMINI_STYLE_MODEL=

STYLE_MAX_VIDEOS_PER_RUN=5

STYLE_MAX_FILE_MB=200

STYLE_MAX_DURATION_SEC=600

STYLE_TIMEOUT_SEC=180

STYLE_MAX_OUTPUT_TOKENS=8192

STYLE_MEDIA_RESOLUTION=low

STYLE_USE_RESPONSE_SCHEMA=true

STYLE_SCHEMA_MODE=flat

STYLE_COMPACT_OUTPUT=false

STYLE_MAX_VIDEO_SEC=180

STYLE_VIDEO_FPS=0.5

STYLE_TPM_LIMIT=250000

STYLE_RPM_LIMIT=2

STYLE_REQUEST_INTERVAL_SEC=5

SCAN_MAX_NEW_VIDEOS=5

SCAN_MAX_VIDEO_SEC=180

SCAN_MAX_AGE_DAYS=180

# Trend Scout metadata only; leave blank to skip the paid provider.

SCRAPECREATORS_API_KEY=

# Optional text LLM routing. Style Learner media remains Gemini-only.

OPENAI_API_KEY=

OPENAI_MODEL=

OPENAI_DIRECTOR_MODEL=

OPENAI_TIMEOUT_SEC=120

OPENAI_RPM_LIMIT=20

OPENAI_MAX_RETRIES=3

LLM_PROVIDER_RESEARCHER=gemini

LLM_PROVIDER_DIRECTOR=gemini

LLM_PROVIDER_TREND=gemini

LLM_PROVIDER_SCRIPT=

LLM_PROVIDER_VISUAL=

OPENAI_SCRIPT_MODEL=

LLM_FALLBACK_PROVIDER=

SCRIPT_V3_ENABLED=false

MAX_ELEMENTS_ON_SCREEN=3

STAGE_ENGINE_ENABLED=false



# Motion graphics HTML (optional; install Chromium separately)

MOTION_ENABLED=false

MOTION_FPS=30

MOTION_SCALE=1.0

MOTION_WORKERS=2

MOTION_SCENES_ENABLED=true

# Bật thư viện công thức chuyển động phong phú (Motion Vocabulary 28+ recipes) & bộ lập lịch không lặp
MOTION_RECIPES_ENABLED=true

MIN_CARD_HOLD_SEC=1.2

AI_CLIPS_PER_VIDEO=0

AI_CLIP_MODEL=

AI_CLIP_MAX_SEC=6

AI_CLIP_BUDGET_PER_DAY=3

MOTION_THEME=auto

MASCOT_ENABLED=true



# Final portrait output; preview is scaled separately

RENDER_WIDTH=1080

RENDER_HEIGHT=1920


# GIAI ĐOẠN 8: SCENE DIRECTOR + HYBRID CLIP
SCENE_DIRECTOR_ENABLED=true
AI_CLIPS_MAX_PER_VIDEO=2
AI_CLIP_MODE=off
AI_CLIP_AUTO_APPROVE=false
AI_CLIP_DAILY_LIMIT=5
AI_CLIP_STALL_SEC=120
